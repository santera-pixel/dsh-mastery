{
  "name": "dsh-mastery",
  "version": "1.1.0",
  "description": "Toggle chips beside the model selector: each adds or removes a skill bundle from the current chat's skill catalog, and each git-backed chip shows whether its source has new commits upstream.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./lib/git": "./lib/git.js",
    "./icon": "./icon.svg",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "skills",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "docs/rail.png",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "slots"
      ]
    }
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node selfcheck.mjs && node tests/updates.mjs && node tests/http.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "cordis",
    "skills",
    "agent-skills",
    "skill-catalog"
  ],
  "author": "santera-pixel (https://github.com/santera-pixel)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santera-pixel/dsh-mastery.git"
  },
  "homepage": "https://github.com/santera-pixel/dsh-mastery#readme",
  "bugs": {
    "url": "https://github.com/santera-pixel/dsh-mastery/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
